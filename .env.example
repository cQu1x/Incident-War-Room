BOT_TOKEN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=incident_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Used for local (non-docker) runs. In docker compose this is overridden
# to http://report-service:8000 automatically.
REPORT_SERVICE_URL=http://localhost:8000

# Optional Telegraph access token for publishing incident timelines.
# Leave empty to create an anonymous account on first use.
TELEGRAPH_ACCESS_TOKEN=

# HTTP API serving incidents to the frontend.
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGIN=*

# Signing secret for the dashboard access tokens (JWT, HS256). Required for the
# web dashboard to authenticate; when empty, no dashboard link is issued.
JWT_SECRET=
# Base URL of the web dashboard used to build the personal, chat-scoped link
# operators receive from the /dashboard command and when an incident is closed,
# and the token time-to-live.
DASHBOARD_URL=https://incident-war-room.ru
DASHBOARD_TOKEN_TTL=168h

# Public deployment (frontend + Caddy reverse proxy).
# SITE_DOMAIN is the domain Caddy serves and requests a TLS cert for.
# PUBLIC_BASE_URL is baked into the frontend bundle as the API base — it must be
# the public https URL of that same domain (Caddy proxies /api/* to the backend).
SITE_DOMAIN=incident-war-room.ru
PUBLIC_BASE_URL=https://incident-war-room.ru

# Set to true to allow attaching media to the timeline. Any media type is
# supported (photos, video, documents, …) and any number per message; albums are
# recorded together as one timeline event. Requires the S3_* values below.
# When false, media is rejected with a "storage not connected" message.
S3_ENABLED=false

S3_ENDPOINT_URL=https://s3.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_PUBLIC_BASE_URL=https://(some_value).selstorage.ru


DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Prometheus Alertmanager integration. ALERT_CHAT_ID is the numeric
# Telegram forum supergroup where incidents opened from alerts are created;
# ALERTMANAGER_WEBHOOK_TOKEN authenticates the webhook. Leave empty to disable.
ALERT_CHAT_ID=
ALERTMANAGER_WEBHOOK_TOKEN=
